{
  "name": "baby-english-monorepo",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "pnpm -F mobile web",
    "dev:edge": "cd apps/edge && supabase functions serve --env-file ./.env.local",
    "dev:all": "concurrently -k \"pnpm dev:edge\" \"pnpm dev\"",
    "lint": "eslint apps/mobile/app apps/mobile/src packages/shared/src/learning packages/shared/src/coach.ts packages/shared/src/coach.test.ts packages/shared/src/cloud.ts tests apps/edge/supabase/functions/_shared apps/edge/supabase/functions/coach apps/edge/supabase/functions/transcribe --max-warnings 0",
    "test": "vitest run",
    "dev:mobile": "pnpm -F mobile start",
    "build": "pnpm -F mobile export:web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "e2e:ci": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:migrations": "node scripts/test-migrations.mjs",
    "preview": "node scripts/serve-web.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.26.0",
    "prettier": "^3.5.3",
    "vitest": "3.2.7",
    "@eslint/js": "^9.26.0",
    "typescript-eslint": "^8.32.0",
    "typescript": "~5.8.3",
    "@types/node": "^22.15.0",
    "@playwright/test": "1.51.1",
    "@vitest/coverage-v8": "3.2.7",
    "@electric-sql/pglite": "0.3.14"
  }
}
